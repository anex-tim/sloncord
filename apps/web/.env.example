# Локальный запуск UI (npm run dev), API на уже развёрнутом удалённом сервере Sloncord:
# Скопируйте в .env.local и подставьте свой хост (без слэша в конце).
VITE_API_BASE=https://your-sloncord-host.example.com

# Репозиторий GitHub для проверки обновлений Windows-клиента (owner/repo):
# VITE_SLONCORD_GITHUB_REPO=your-user/sloncord
