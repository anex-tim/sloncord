# /etc/sloncord/sloncord.env — только IP, без домена (136.234.12.106)

ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=sloncord;Username=sloncord;Password=CHANGE_ME
SLONCORD_DATA_DIR=/data/sloncord

SLONCORD_PUBLIC_ORIGIN=https://136.234.12.106
SLONCORD_WINDOWS_CLIENTS_ONLY=1

# Legacy WebRTC only (SLONCORD_VOICE_MODE=legacy):
# SLONCORD_TURN_URLS=turn:136.234.12.106:3478?transport=udp
# SLONCORD_SFU_SECRET=...
# Sloncord__Voice__Sfu__Url=wss://136.234.12.106/ws/sfu

# Native Opus/UDP voice (default). legacy = mediasoup/WebRTC in client.
SLONCORD_VOICE_MODE=native
SLONCORD_VOICE_NATIVE_ENABLED=1
SLONCORD_VOICE_NATIVE_PUBLIC_HOST=136.234.12.106
SLONCORD_VOICE_NATIVE_PORT=50050
