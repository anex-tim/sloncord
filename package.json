{
  "name": "sloncord",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "apps/moderation"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @sloncord/web",
    "build:web": "npm run build -w @sloncord/web",
    "dev:desktop": "npm run dev -w @sloncord/desktop",
    "build:desktop": "npm run build -w @sloncord/desktop",
    "build:desktop-installer": "npm run build:installer -w @sloncord/desktop",
    "deploy": "node scripts/deploy-website.mjs",
    "deploy:backend": "node scripts/deploy-website.mjs",
    "deploy:with-clients": "node scripts/deploy-website.mjs --with-clients",
    "publish:desktop": "node scripts/publish-desktop-github.mjs",
    "github:bootstrap": "node scripts/github-bootstrap.mjs",
    "deploy:upload": "node scripts/deploy-website.mjs --no-build",
    "deploy:full": "node scripts/deploy-website.mjs --full-sftp",
    "deploy:upload:full": "node scripts/deploy-website.mjs --no-build --full-sftp",
    "deploy:desktop": "node scripts/deploy-website.mjs --desktop-only",
    "deploy:upload:desktop": "node scripts/deploy-website.mjs --no-build --desktop-only",
    "dev:moderation": "npm run dev -w @sloncord/moderation",
    "build:moderation": "npm run build -w @sloncord/moderation"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "playwright": "^1.61.0",
    "sharp": "^0.33.5",
    "ssh2": "^1.16.0",
    "ssh2-sftp-client": "^11.0.0"
  }
}
